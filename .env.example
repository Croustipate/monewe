MONEWEB_URL=https://<url-de-votre-portail>
MONEWEB_ID=VOTRE_IDENTIFIANT
MONEWEB_PASSWORD=votre_mot_de_passe
SYNC_HOUR=2
PORT=3000

# Protection par mot de passe (optionnel — supprimer les lignes pour désactiver)
AUTH_USER=admin
AUTH_PASSWORD=votre_mot_de_passe_acces

# Proxy d'entreprise (optionnel)
# HTTPS_PROXY=http://proxy.entreprise.fr:8080
# Si le proxy demande une authentification :
# HTTPS_PROXY=http://utilisateur:mot_de_passe@proxy.entreprise.fr:8080
# Si le proxy inspecte le TLS (certificat d'entreprise) :
# NODE_TLS_REJECT_UNAUTHORIZED=0
